+#include "driver/chip/hal_efuse.h"
 #include "pm/pm.h"
 
 uint32_t SystemCoreClock;
 extern const unsigned char __RAM_BASE[];	/* SRAM start address */
 
+/* ABUS PPIC90520: register values seen at SystemInit (before/after the
+ * adjust), printed by the app for diagnosis. */
+uint32_t abus_efuse_early = 0xdeadbeef;
+uint32_t abus_prcm_dbg[4] = { 0xdeadbeef, 0xdeadbeef, 0xdeadbeef, 0xdeadbeef }; /* .data: not hit by bss clearing */
+
 __STATIC_INLINE void SystemChipAdjust(void)
 {
 #ifdef __CONFIG_CHIP_XR871
-	if (1) { //(HAL_GlobalGetChipVer() <= 0xB) {
+	/* ABUS test: a real software eFuse read here, where the stock app does
+	 * its first one (chip version, bits 608..609). Result printed later;
+	 * 0xdeadbeef in the print = this line was never reached. */
+	{
+		uint8_t b = 0xee;
+		HAL_Status st;
+
+		HAL_EFUSE_CacheAll();
+		st = HAL_EFUSE_Read(608, 2, &b);
+		abus_efuse_early = ((uint32_t)st << 8) | b;
+	}
+	abus_prcm_dbg[0] = PRCM->DIG_LDO_PARAM;
+	abus_prcm_dbg[1] = PRCM->DCDC_PARAM_CTRL;
+	/* ABUS: back to the stock (SDK 1.3.0) behaviour. SDK 1.4.0 forced the
+	 * DIG_LDO trim unconditionally and rewrote the DCDC bandgap trim from
+	 * eFuse bits; with that, the first software eFuse read reset the chip
+	 * on this board. Stock only sets DIG_LDO for chip version <= 0xB and
+	 * never touches the DCDC trim. */
+	if (HAL_GlobalGetChipVer() <= 0xB) {
 		HAL_MODIFY_REG(PRCM->DIG_LDO_PARAM,
 		               PRCM_DIG_LDO_BANDGAP_TRIM_MASK,
 		               7U << PRCM_DIG_LDO_BANDGAP_TRIM_SHIFT);
 	}
-
+#if 0
 	uint8_t val = HAL_GlobalGetSmpsBgtr();
 	if (val != 0xff) {
 		HAL_MODIFY_REG(PRCM->DCDC_PARAM_CTRL,
 		               PRCM_DCDC_BANDGAP_TRIM_MASK,
 		               (uint32_t)val << PRCM_DCDC_BANDGAP_TRIM_SHIFT);
 	}
+#endif
+	abus_prcm_dbg[2] = PRCM->DIG_LDO_PARAM;
+	abus_prcm_dbg[3] = PRCM->DCDC_PARAM_CTRL;
 #endif
 }
 
