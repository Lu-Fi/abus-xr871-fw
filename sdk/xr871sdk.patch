diff --git a/src/driver/chip/hal_efuse.c b/src/driver/chip/hal_efuse.c
index 33298f2..49b6033 100644
--- a/src/driver/chip/hal_efuse.c
+++ b/src/driver/chip/hal_efuse.c
@@ -109,8 +109,13 @@ __STATIC_INLINE void EFUSE_SetTimingParam(EFUSE_TimingParam timingParam)
 	EFUSE->TIMING_CTRL = timingParam;
 }
 
+extern uint32_t abus_efuse_cached;
+
 static HAL_Status EFUSE_Init(void)
 {
+	if (abus_efuse_cached == 64)	/* served from the early RAM copy */
+		return HAL_OK;
+
 	uint32_t clk;
 	EFUSE_TimingParam timingParam;
 
@@ -147,6 +152,34 @@ static void EFUSE_ReadData(uint8_t index, uint32_t *pData)
 	EFUSE_DisableClkGate();
 }
 
+
+/* ABUS PPIC90520: on this board a software eFuse read is reliable only very
+ * early in SystemInit (where the stock app does its first one); later reads
+ * reset the chip (brown-out-like). So all 64 words are read once there and
+ * every later HAL_EFUSE_Read is served from this RAM copy. Kept in .data
+ * (non-zero initialisers) because SystemInit runs before .bss is cleared. */
+uint32_t abus_efuse_cache[64] = { 0xffffffffU };
+uint32_t abus_efuse_cached = 0xdeadbeefU;	/* words cached, or 0xdeadbeef */
+
+void HAL_EFUSE_CacheAll(void)
+{
+	uint32_t w;
+
+	if (EFUSE_Init() != HAL_OK)
+		return;
+	for (w = 0; w < 64; w++)
+		EFUSE_ReadData((uint8_t)w, &abus_efuse_cache[w]);
+	abus_efuse_cached = 64;
+}
+
+static void EFUSE_ReadWord(uint8_t index, uint32_t *pData)
+{
+	if (abus_efuse_cached == 64)
+		*pData = abus_efuse_cache[index & 63];
+	else
+		EFUSE_ReadData(index, pData);
+}
+
 /**
  * @brief Read an amount of data from EFUSE
  * @param[in] start_bit The first bit to be read on EFUSE
@@ -200,10 +233,10 @@ HAL_Status HAL_EFUSE_Read(uint32_t start_bit, uint32_t bit_num, uint8_t *data)
 	HAL_Memset(data, 0, byte_num);
 
 	while (byte_cnt > 0) {
-		EFUSE_ReadData((uint8_t)word_idx, &efuse_word[0]);
+		EFUSE_ReadWord((uint8_t)word_idx, &efuse_word[0]);
 
 		if (word_idx + 1 < 64) {
-			EFUSE_ReadData((uint8_t)word_idx + 1, &efuse_word[1]);
+			EFUSE_ReadWord((uint8_t)word_idx + 1, &efuse_word[1]);
 		} else {
 			efuse_word[1] = 0;
 		}
diff --git a/src/driver/chip/system_chip.c b/src/driver/chip/system_chip.c
index 9e81d24..e3007ba 100644
--- a/src/driver/chip/system_chip.c
+++ b/src/driver/chip/system_chip.c
@@ -30,26 +30,53 @@
